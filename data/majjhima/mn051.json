    {
      "id": "MN51-P04",
      "category": "speech",
      "ref": "MN 51",
      "section": "掩心",
      "observe": "人は自心を隠す心う、動物は率直",
      "action": "言葉と心が違う場面を一つ認め、正直に整える",
      "quote": "人々は己の心を隠す心い隠す。動物は率直なり"
    },
    {
      "id": "MN51-P05",
      "category": "suffering",
      "ref": "MN 51",
      "section": "四人",
      "observe": "四種の人——自分を苦しめる·他者を苦しめる·両方を苦しめる·中道",
      "action": "今日の行いが四種のどれか、一度問う",
      "quote": "自己をも苦しめるせず、他の衆生をも苦しめるせず——この生において静まるし、静かに滅するし、清涼にして、楽を体験し、天のようなののように生きるする者"
    },
    {
      "id": "MN51-P06",
      "category": "desire",
      "ref": "MN 51",
      "section": "自苦",
      "observe": "自分を苦しめるの行者——裸の·時を外れた食·刺床等、身を酷使する",
      "action": "今日、結果を急ぐあまり身を酷使していないか問う",
      "quote": "これらの諸方法を修習し、不断にこの身体を苦しめるする"
    },
    {
      "id": "MN51-P07",
      "category": "desire",
      "ref": "MN 51",
      "section": "他苦",
      "observe": "他者を苦しめるの行者——屠殺·盗み·血腥の業",
      "action": "今日、直接間接に他者の苦を招く選択を避ける",
      "quote": "山羊を屠る者、豚を屠る者……鳥獣を捕る者、盗賊、処刑人——これ、他を苦しめる者なり"
    },
    {
      "id": "MN51-P08",
      "category": "prep",
      "ref": "MN 51",
      "section": "中道",
      "observe": "第四の人——如来の説く段階的道：戒→根護→念→足るを知る→禅定→慧",
      "action": "今日、道の次第のうち一段階（例：足るを知る）を意識する",
      "quote": "自己をも苦しめるせず、他の衆生をも苦しめるせず——如来の説く次第の道を歩む者は、この生において静まるし、静かに滅するし、清涼にして、楽を体験し、天のようなののように生きるする——と称される"
    },
    {
      "id": "MN51-P09",
      "category": "work",
      "ref": "MN 51",
      "section": "中道",
      "observe": "中道の修行者——五つの蓋除から煩悩の滅尽まで、段階を踏む",
      "action": "苦·集·滅·道の一つに意識を向ける",
      "quote": "彼はあるがままにに苦を知り、あるがままにに苦集を知り、あるがままにに苦滅を知り、あるがままにに苦滅に至る道を知る"
    },
    {
      "id": "MN51-P10",
      "category": "people",
      "ref": "MN 51",
      "section": "結",
      "observe": "ビッサは早く帰るした——聞いて信じ、詳しく説くを聞けば更に益",
      "action": "誰かに助言するとき、一つの段階から始める",
      "quote": "比夜提が暫しこの処に座し留まりたらば、私はこの四種の人について詳しく説きたものを"
    }
