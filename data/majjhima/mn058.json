  "pairs": [
    {
      "id": "MN58-P01",
      "category": "speech",
      "ref": "MN 58",
      "section": "導",
      "observe": "無畏王子——如来は人を害する言葉を語るか",
      "action": "今日、言葉が相手を傷つけるか、一度問う",
      "quote": "尊者よ、如来は他人の好まない・嫌うなる語を語るべきか。王子よ、まったく実にそのことなし"
    },
    {
      "id": "MN58-P02",
      "category": "speech",
      "ref": "MN 58",
      "section": "四語",
      "observe": "事実でない·真実でない·不相手のためになる·不快——語らない",
      "action": "今日、真実でも相手を傷つけるだけの言葉を一度飲み込む",
      "quote": "如来は、その語が事実でない·真実でない·不相手のためになるにして、他人の好まない・嫌うなるものと知れば、如来はすなわちその語を語らず"
    },
    {
      "id": "MN58-P03",
      "category": "speech",
      "ref": "MN 58",
      "section": "四語",
      "observe": "実·真·不相手のためになる·不快——語らない",
      "action": "正しいが役に立たない批判は、今日一つ控える",
      "quote": "また如来は、その語があるがままに·真実なりといえども、不相手のためになるにして、他人の好まない・嫌うなるものと知れば、如来もまたその語を語らず"
    },
    {
      "id": "MN58-P04",
      "category": "speech",
      "ref": "MN 58",
      "section": "四語",
      "observe": "実·真·相手のためになる·不快——時を知るに語るする",
      "action": "アドバイスする前に「今、聞く心があるか」を確認する",
      "quote": "しかるに如来は、その語があるがままに·真実·相手のためになるにして、他人の好まない・嫌うなるものと知れば、如来はその語を語るすることは時を知るなり"
    },
    {
      "id": "MN58-P05",
      "category": "speech",
      "ref": "MN 58",
      "section": "四語",
      "observe": "事実でない·真実でない·不相手のためになる·快——語らない",
      "action": "今日、相手を喜ばせるための嘘·迎合を一度止める",
      "quote": "また如来は、その語が事実でない·真実でない·不相手のためになるにして、たとい他人の好む・好ましいなるものであっても、如来はすなわちその語を語らず"
    },
    {
      "id": "MN58-P06",
      "category": "speech",
      "ref": "MN 58",
      "section": "四語",
      "observe": "実·真·不相手のためになる·快——語らない",
      "action": "今日、正しくても無益な言葉を一つ減らす",
      "quote": "また如来は、その語があるがままに·真実なりといえども、不相手のためになるにして、他人の好む・好ましいなるものと知れば、この語を如来は語らず"
    },
    {
      "id": "MN58-P07",
      "category": "speech",
      "ref": "MN 58",
      "section": "四語",
      "observe": "実·真·相手のためになる·快——時を知るに説く",
      "action": "今日、相手の利益になる言葉を一つ、意図的に選ぶ",
      "quote": "如来は、その語があるがままに·真実·相手のためになるにして、かつ他人の好む・好ましいなるものと知れば、如来はその語を説くことは時を知るなり"
    },
    {
      "id": "MN58-P08",
      "category": "people",
      "ref": "MN 58",
      "section": "憐愍",
      "observe": "如来が語るのは、あらゆる生き物へのあわれみがあるから",
      "action": "言う前に「これは相手の利益か」を一呼吸置いて問う",
      "quote": "王子よ、何ゆえにか。如来はあらゆる生き物に対してあわれみ心あるが故なり"
    },
    {
      "id": "MN58-P09",
      "category": "people",
      "ref": "MN 58",
      "section": "喩",
      "observe": "幼い子の口の木の破片·小石——あわれみから必ず除却",
      "action": "今日、相手の過ちを指摘するとき、あわれみから語る",
      "quote": "私は必ずそれを取り出さん。何ゆえにか。尊者よ、私は幼い子に対してあわれみ心あるが故なり"
    },
    {
      "id": "MN58-P10",
      "category": "prep",
      "ref": "MN 58",
      "section": "答",
      "observe": "両端の問い——角のある鉄の刺の如く、吐き出すも飲み込むもできない",
      "action": "今日、答えを保留する勇気を一つ持つ",
      "quote": "修行者瞿曇は、あなたのこの両端の問いに対して、吐き出すこともできず、飲み込むこともできまい。恰も角のある鉄の刺が人の喉に刺さるがのように"
    },
    {
      "id": "MN58-P11",
      "category": "work",
      "ref": "MN 58",
      "section": "答",
      "observe": "如来は法をよく知り、あらかじめの用意なく答が現前する",
      "action": "会話の前に「正答の用意」をせず、正知で臨む",
      "quote": "あらかじめよく考えるせずとも、その答えは如来に直接に現れる。王子よ、まさに、かの法は如来によく知らせられただから、自ら彼の法をよく知るるがだから、その答えは如来に直接に現れるなり"
    },
    {
      "id": "MN58-P12",
      "category": "people",
      "ref": "MN 58",
      "section": "結",
      "observe": "王子——聞いて帰依し、在家信者となる",
      "action": "反論したくなったとき、一度黙って聞く",
      "quote": "師よ、それだから、私は世尊に帰依し、法に帰依し、比丘僧伽に帰依する。どうか世尊、私を今より以後、生涯、仏·法·僧に帰依するる在家信者と認めてください"
    }
  ]
